# ─── Sanity CMS (blog en /blog) ───────────────────────────────────────
# 1. Crea tu proyecto en https://sanity.io/manage
# 2. Copia estos valores a un nuevo archivo .env.local
# 3. Cuando tengas posts, cambia BLOG_ENABLED a true en app/[locale]/blog/page.tsx
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ─── Resend — formulario de contacto ──────────────────────────────────
# Crea la API key en https://resend.com/api-keys
# El dominio de RESEND_FROM_EMAIL debe estar verificado en Resend
# (Domains → Add Domain → agrega los TXT / CNAME al DNS).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Marsa Project <hola@marsaproject.com>
RESEND_TO_EMAIL=informes@marsaproject.com

# ─── Google Ads (gtag.js) ─────────────────────────────────────────────
# NEXT_PUBLIC_GADS_ID — ID de la cuenta (formato "AW-XXXXXXXXXX")
# CONVERSION_LABEL   — etiqueta de la acción "Lead form" en Google Ads
# WHATSAPP_LABEL     — etiqueta de la acción "WhatsApp click"
# (En Google Ads: Herramientas → Conversiones → crea la acción y copia la
#  parte que va DESPUÉS de la barra en send_to: "AW-xxxx/AbCdEfG_1234")
NEXT_PUBLIC_GADS_ID=AW-17871428510
NEXT_PUBLIC_GADS_CONVERSION_LABEL=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
